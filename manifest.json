{
  "manifest_version": 3,
  "name": "EG AI 助手 · 检索 / 图片 / 翻译 / 下载",
  "version": "2.0.0",
  "description": "一句话检索网站/视频/图片、英文自动识别翻译、网页要点总结，抖音/B站分享链接自动下载。AI 接入云端 API 模型。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "scripting",
    "activeTab",
    "sidePanel",
    "offscreen",
    "contextMenus",
    "webRequest",
    "tts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "EG AI 助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.douyin.com/*"
      ],
      "js": [
        "content-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "download-prompt.js",
        "download-discover.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "打开 EG AI 助手侧边栏"
    }
  }
}